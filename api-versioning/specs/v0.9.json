{
  "swagger": "2.0",
  "info": {
    "title": "Payments API",
    "version": "0.9.0",
    "description": "Swagger 2 and JSON, to prove both are discovered."
  },
  "basePath": "/v0",
  "paths": {
    "/payments": {
      "get": {
        "summary": "List payments",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "All payments",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/LegacyPayment"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "LegacyPayment": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount_cents": { "type": "integer" }
      }
    }
  }
}
